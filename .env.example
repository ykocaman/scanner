# Per-request HTTP timeout (Go duration, e.g. 90s).
# HTTP_TIMEOUT=5m

# --- CVE sources ---------------------------------------------------------

USE_REDHAT=true
# REDHAT_CVE_URL=https://access.redhat.com/hydra/rest/securitydata/cve.json
# REDHAT_PER_PAGE=1000

# Off by default: ~70MB feed, fetched in full on every enabled run.
USE_DEBIAN=false
# DEBIAN_TRACKER_URL=https://security-tracker.debian.org/tracker/data/json

# Off by default: feed is several hundred MB.
USE_UBUNTU=false
# UBUNTU_USN_URL=https://usn.ubuntu.com/usn-db/database-all.json

# Off by default: apk package data rarely matches an apt-based host — see README.
USE_ALPINE=false
# ALPINE_SECDB_URL=https://secdb.alpinelinux.org/v3.20/community.json

# --- Caching --------------------------------------------------------------

# Skip findings already reported by a previous run.
USE_CACHING=true
# CACHE_PATH=/tmp/scanner-cache

# --- Email ------------------------------------------------------------

SEND_MAIL=false
MAIL_SERVER_HOST=
MAIL_SERVER_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=

# --- Elasticsearch ------------------------------------------------------

USE_ELASTIC=false
ELASTIC_HOST=http://127.0.0.1:9200
ELASTIC_INDEX=scanner
