# Per-request HTTP timeout (Go duration, e.g. 90s).
# HTTP_TIMEOUT=5m

# --- CVE sources -----------------------------------------------------------
#
# Which source runs is auto-detected from the host's distro (Debian ->
# Red Hat + Debian, Alpine -> Alpine, everything else -> Red Hat) — not
# configurable, nothing to set here. The URLs below are optional, only
# needed to point a source at a mirror or a different feed.

# REDHAT_CVE_URL=https://access.redhat.com/hydra/rest/securitydata/cve.json
# DEBIAN_TRACKER_URL=https://security-tracker.debian.org/tracker/data/json
# ALPINE_SECDB_URL=https://secdb.alpinelinux.org/v3.24/main.json,https://secdb.alpinelinux.org/v3.24/community.json

# Ubuntu's own USN feed (hundreds of MB) is the one source that's never
# auto-enabled, even on Ubuntu. Set the URL to opt in — its presence is
# what turns the source on:
# UBUNTU_USN_URL=https://usn.ubuntu.com/usn-db/database-all.json

# --- Caching ----------------------------------------------------------------
#
# Always on; only the location is configurable.
# CACHE_PATH=/tmp/scanner-cache

# --- Email -------------------------------------------------------------
#
# Set MAIL_TO to turn on emailing the summary report.
MAIL_TO=
MAIL_SERVER_HOST=
MAIL_SERVER_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Elasticsearch ------------------------------------------------------
#
# Set ELASTIC_HOST to turn on indexing every finding.
ELASTIC_HOST=
ELASTIC_INDEX=scanner
